#include <stdio.h>

int main() {
    //Declaracão das variaveis
    int x, y;

    
    while (1) {
        scanf("%d %d", &x, &y);

        //se X ou Y for igual a zero
        if (x == 0 || y == 0) {
            break;
        }

        // Verificação dos quadrantes
        if (x > 0 && y > 0) 
        {
            printf("primeiro\n");
        } 
        else if (x < 0 && y > 0)
        {
            printf("segundo\n");
        } 
        else if (x < 0 && y < 0) 
        {
            printf("terceiro\n");
        } else 
        {
            printf("quarto\n");
        }
    }

    return 0;
}
*- Descrição: Cálculo da quantidade de notas de cada valor
*- necessário para representar um valor inteiro em reais.
*
------------------------------------------------------------------*/
#include <iostream>
using namespace std;

int main() {
    int N;
    cin >> N;

    cout << N << endl;

    int notas[] = {100, 50, 20, 10, 5, 2, 1};

    for (int i = 0; i < 7; i++) {
        int quantidade = N / notas[i];
        N = N % notas[i];

        cout << quantidade << " nota(s) de R$ "
             << notas[i] << ",00" << endl;
    }

    return 0;
}












